# Copy this file to .env and fill in the values: cp .env.example .env
# Never commit the .env file.

# Port of the Express server
PORT=3000

# PostgreSQL credentials (used by docker-compose.yml)
POSTGRES_USER=flashcards
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flashcards
POSTGRES_PORT=5432

# URL of the frontend, used for CORS (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Connection string for the server, must match the values above
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://flashcards:change-me@localhost:5432/flashcards

# Secret for signing JWTs, at least 32 random characters
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Optional: AI answer check via OpenRouter (https://openrouter.ai).
# Without a key the app works as before, the check answers 503.
# Set a spending limit for this key in the OpenRouter settings.
OPENROUTER_API_KEY=
# Model id on OpenRouter, default: anthropic/claude-haiku-5.5
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
