
# Port des Express-Servers
PORT=3000

# Zugangsdaten für die PostgreSQL-Datenbank (genutzt von docker-compose.yml)
POSTGRES_USER=flashcards
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=flashcards
POSTGRES_PORT=5432

# Verbindungsadresse für den Server (muss zu den Werten oben passen)
# Aufbau: postgresql://BENUTZER:PASSWORT@HOST:PORT/DATENBANK
DATABASE_URL=postgresql://flashcards:bitte-aendern@localhost:5432/flashcards
